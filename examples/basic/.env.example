# ─── Application ─────────────────────────────────────────────

# Environment the app runs in
# @enum development,production,test
NODE_ENV=development

# Port the HTTP server listens on
# @type port
PORT=3000

# Public base URL of the API, without a trailing slash
# @type url @pattern ^https?://[^/]+$
API_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────

# PostgreSQL connection string
# @type url @secret
DATABASE_URL=postgres://user:password@localhost:5432/app

# Max connections in the pool
# @type int @min 1 @max 100
DB_POOL_SIZE=10

# ─── Integrations ────────────────────────────────────────────

# Error reporting; leave empty to disable
# @type url @optional @secret
SENTRY_DSN=

# Address shown in outgoing emails
# @type email
SUPPORT_EMAIL=support@example.com

# Feature flags as a JSON object
# @type json @optional
FEATURE_FLAGS={"newDashboard":false}

# Verbose logging
# @type bool
DEBUG=false
